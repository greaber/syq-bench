# Copy to the gitignored .env.infra for your own infrastructure account, then
# fill the credentials for providers you use and encrypt the file before running.
FLY_API_TOKEN=
FLY_ORG=

# Hetzner dedicated servers use Robot Webservice credentials, not a Cloud token.
# Quote the username because it can start with #. Provisioning is not yet implemented.
HETZNER_ROBOT_USER=''
HETZNER_ROBOT_PASSWORD=''
